# AI Model Configuration
# The name of the Ollama model to use (e.g., gemma4:cloud for cloud, llama3.2 for local)
OLLAMA_MODEL=gemma4:cloud
# The base URL of the Ollama service
OLLAMA_BASE_URL=https://ollama.com
# Your Ollama Cloud API Key (Never put a real key in this file!)
OLLAMA_API_KEY=<your_api_key_here>

# Retrieval Configuration
# Options: fastembed (default, small ONNX models), bm25 (keyword only), local (sentence-transformers)
EMBEDDING_BACKEND=fastembed

# Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting & Abuse Protection
MAX_UPLOADS_PER_HOUR=10
MAX_CHATS_PER_HOUR=50
MAX_SUMMARIES_PER_HOUR=5
MAX_PAGE_COUNT=50
MAX_CONCURRENT_SUMMARIES=2
REQUEST_TIMEOUT=60
